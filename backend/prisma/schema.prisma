generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                     Int       @id @default(autoincrement())
  company_id             Int
  company                Companies @relation(fields: [company_id], references: [id])
  role_id                Int
  role                   Roles     @relation(fields: [role_id], references: [id])
  name                   String
  email                  String    @unique
  password               String
  password_reset_token   String?
  password_reset_expires DateTime?
  driver                 Driver?
}

model Roles {
  id          Int               @id @default(autoincrement())
  role        RoleType          @unique
  users       Users[]
  permissions RolePermissions[]
}

enum RoleType {
  ADMIN
  DRIVER
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

model RolePermissions {
  id        Int      @id @default(autoincrement())
  role_id   Int
  role      Roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  resource  String   // "FLEET", "DRIVERS", "TRIPS", "FUEL_EXPENSE", "ANALYTICS"
  access    String   // "WRITE", "READ", "NONE"

  @@unique([role_id, resource])
}

model Companies {
  id            Int        @id @default(autoincrement())
  name          String
  currency      String     @default("INR (Rs)")
  distance_unit String     @default("Kilometers")
  users         Users[]
  vehicles      Vehicles[]
}

model Vehicles {
  company_id       Int
  company          Companies     @relation(fields: [company_id], references: [id])
  reg_no           String        @id
  vehicle_model    String
  type             String
  load_capacity    Float
  odometer_reading Float
  cost             Float
  status           VehicleStatus
  trips            Trip[]
  fuel_logs        Fuel_Logs[]
  expenses         Expenses[]
  maintenances     Maintenance[]
}

model Maintenance {
  id           Int         @id @default(autoincrement())
  reg_no       String
  vehicle      Vehicles    @relation(fields: [reg_no], references: [reg_no])
  service_type ServiceType
  cost           Float
  date           DateTime
  status         String
  jira_issue_key String?
  jira_issue_id  String?
  jira_issue_url String?
  jira_status    String?
}

model Driver {
  license_no   String       @id
  driver_id    Int          @unique
  user         Users        @relation(fields: [driver_id], references: [id])
  status       DriverStatus
  safety_score Float
  license_type         String
  expiry_date          DateTime
  contact_number       String       @default("")
  trip_completion_rate Float        @default(0)
  trips                Trip[]
}

model Trip {
  id              Int        @id @default(autoincrement())
  reg_no          String
  vehicle         Vehicles   @relation(fields: [reg_no], references: [reg_no])
  driver_id       Int
  driver          Driver     @relation(fields: [driver_id], references: [driver_id])
  src             String
  dest            String
  src_lat         Float?
  src_lng         Float?
  dest_lat        Float?
  dest_lng        Float?
  cargo_weight    Float
  trip_dist       Float
  trip_status     TripStatus
  created_at      DateTime   @default(now())
  start_trip_at   DateTime?
  expenses        Expenses[]
}

model Fuel_Logs {
  id        Int      @id @default(autoincrement())
  reg_no    String
  vehicle   Vehicles @relation(fields: [reg_no], references: [reg_no])
  date      DateTime
  litres    Float
  fuel_cost Float
}

model Expenses {
  id          Int      @id @default(autoincrement())
  trip_id     Int
  trip        Trip     @relation(fields: [trip_id], references: [id])
  reg_no      String
  vehicle     Vehicles @relation(fields: [reg_no], references: [reg_no])
  maintenance Float
  toll        Float
  others      Float
}

enum VehicleStatus {
  Available
  On_Trip   @map("On Trip")
  In_Shop   @map("In Shop")
  Retired
}

enum DriverStatus {
  Available
  On_Trip   @map("On Trip")
  Off_Duty  @map("Off Duty")
  Suspended
}

enum TripStatus {
  Draft
  Dispatched
  Completed
  Cancelled
}

enum ServiceType {
  Routine_Service
  Oil_Change
  Tire_Replacement
  Brake_Service
  Engine_Repair
  Other
}
